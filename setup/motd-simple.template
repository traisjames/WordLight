#!/bin/bash
export TERM=xterm-256color
let upSeconds="$(/usr/bin/cut -d. -f1 /proc/uptime)" 
let secs=$((${upSeconds}%60))
let mins=$((${upSeconds}/60%60))
let hours=$((${upSeconds}/3600%24))
let days=$((${upSeconds}/86400))
UPTIME=`printf "%d days, %02dh %02dm %02ds" "$days" "$hours" "$mins" "$secs"`
 
# get the load averages read one five fifteen
read one five fifteen rest < /proc/loadavg
 
echo "
 Date...............: `date +"%A, %e %B %Y, %r"` 
 Uptime.............: ${UPTIME}
 Memory.............: `cat /proc/meminfo | grep MemFree | awk {'print $2'}`kB (Free) / `cat /proc/meminfo | grep MemTotal | awk {'print $2'}`kB (Total)
 Load Averages......: ${one}, ${five}, ${fifteen} (1, 5, 15 min)
 Running Processes..: `ps ax | wc -l | tr -d " "`
 Free Disk Space....: `df -Pk | grep -E '^/dev/mmcblk0p2' | awk '{ print $4 }'`k (`df -Pk | grep -E '^/dev/mmcblk0p2' | awk '{ print $5 }'` used) on /
 System.............: `uname -no`
       .............: `uname -rp`
 IP Addresses.......: LAN: `/sbin/ifconfig eth0 | /bin/grep "inet " | awk '{ print $2 }'` $(tput setaf 6) WIFI: `/sbin/ifconfig wlan0 | /bin/grep "inet " | awk '{ print $2 }'` $(tput setaf 1)WAN: `wget -q --timeout=2 --tries=1 -O - http://icanhazip.com/ 2>/dev/null | tail`$(tput sgr0)
"
