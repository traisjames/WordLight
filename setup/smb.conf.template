# Samba settings for WordLight, written by setup/setup.sh from
# setup/smb.conf.template. setup.sh fills in the {{...}} names; running its
# "Network shares" option again rewrites this file (the old one is kept as
# /etc/samba/smb.conf.backup-<time>).

#======================= Global Settings =======================

[global]

   workgroup = WORKGROUP
   netbios name = WordLight_Server
;   interfaces = 127.0.0.0/8 eth0
;   bind interfaces only = yes

   log file = /var/log/samba/log.%m
   max log size = 1000
   logging = file
   panic action = /usr/share/samba/panic-action %d

   server role = standalone server
   obey pam restrictions = yes
   unix password sync = yes
   passwd program = /usr/bin/passwd %u
   passwd chat = *Enter\snew\s*\spassword:* %n\n *Retype\snew\s*\spassword:* %n\n *password\supdated\ssuccessfully* .
   pam password change = yes

# Unrecognized/failed logins fall back to guest instead of being rejected
   map to guest = bad user

   access based share enum = yes
   usershare allow guests = yes

#======================= Share Definitions =======================

[CC Server]
  comment = WordLight server files
  read only = no
  browsable = yes
  valid users = {{USER}}
  path = {{PROJECT_DIR}}

[{{SCRIPTS_SHARE}}]
 comment = Store scripts here - {{SCRIPTS_COMMENT}}
 path = {{SCRIPTS_DIR}}
 browsable = yes
 guest ok = {{SCRIPTS_GUEST}}
 read only = yes
 write list = {{USER}}, WordMaker
# Everything saved here belongs to {{USER}} (who runs WordLight), so WordLight
# can always edit it, even in folders made over the network. Who may write is
# still checked against the login actually used (write list above).
 force user = {{USER}}
 force group = scriptusers
 create mask = 0664
 directory mask = 0775

[Wordlight Home]
 comment = Full home directory (read-write for {{USER}} only)
 path = {{HOME}}
 browsable = yes
 guest ok = no
 valid users = {{USER}}
 read only = no
 create mask = 0770
 directory mask = 0770
